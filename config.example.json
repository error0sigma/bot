{
  "limits": {
    "max_depth": 2,
    "max_sources": 50,
    "max_requests_per_source": 20,
    "max_runtime": 300,
    "confidence_threshold": 0.55,
    "retry_count": 3
  },
  "http": {
    "enabled": true,
    "allowed_domains": ["api.github.com", "github.com"],
    "user_agent": "public-discovery-engine/0.2",
    "requests_per_minute": 30,
    "respect_robots_txt": true,
    "max_response_bytes": 2000000
  },
  "connectors": {
    "github": {"enabled": true},
    "rss": {"enabled": false, "feeds": []},
    "search_api": {"enabled": false},
    "public_profiles": {"enabled": true}
  },
  "sheets": {"enabled": false, "webhook_url": "", "path": "discovery-sheets.jsonl"},
  "background": {
    "refresh_after_seconds": 86400,
    "max_items_per_cycle": 100,
    "interval": 3600
  }
}
